---
const { pathname } = Astro.url;

const links = [
  {
    href: '/',
    label: 'Home',
    icon:
      '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  },
  {
    href: '/how-to-use',
    label: 'How to use',
    icon:
      '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
  },
  {
    href: '/about',
    label: 'About',
    icon:
      '<circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>',
  },
  {
    href: '/contact',
    label: 'Contact',
    icon:
      '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22 6 12 13 2 6"/>',
  },
];

// Static output uses .html filenames (and /index.html for the root) while
// hosts vary trailing slashes, so compare against a normalized pathname.
const current =
  pathname
    .replace(/\.html$/, '')
    .replace(/\/index$/, '')
    .replace(/\/+$/, '') || '/';
---

<header class="masthead">
  <div class="shell masthead__inner">
    <a class="wordmark" href="/">
      <img src="/logo.svg" alt="unicodeTOpreeti logo" class="wordmark__logo" />
      <span class="wordmark__text">unicodeTOpreeti</span>
    </a>

    <div class="masthead__cluster">
      <nav class="masthead__nav" aria-label="Main">
        <!-- Home stays in the top bar on every screen size. -->
        <ul class="masthead__nav-bar">
          <li>
            <a
              href={links[0].href}
              aria-current={current === links[0].href ? 'page' : undefined}
            >
              <svg
                class="nav-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={links[0].icon}
              />
              <span class="nav-label">{links[0].label}</span>
            </a>
          </li>
        </ul>

        <!-- The rest of the menu; tucked behind the hamburger on phones. -->
        <ul class="masthead__nav-menu" id="masthead-menu" aria-label="More">
          {
            links.slice(1).map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={current === link.href ? 'page' : undefined}
                >
                  <svg
                    class="nav-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={link.icon}
                  />
                  <span class="nav-label">{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle"
        aria-label="Toggle dark mode"
      >
        <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <g stroke="currentColor" stroke-width="1.5" fill="none">
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </g>
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M21 12.79A9 9 0 0 1 11.21 3 7 7 0 1 0 21 12.79z"/>
        </svg>
      </button>

      <button
        type="button"
        id="nav-toggle"
        class="hamburger"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="masthead-menu"
      >
        <svg class="hamburger__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg class="hamburger__icon hamburger__icon--close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Inline script so the theme is applied before the page paints. -->
  <script data-theme-script>
    (function () {
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = stored ?? (prefersDark ? 'dark' : 'light');
      if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
    })();
  </script>
  <script data-theme-listener>
    const toggle = document.getElementById('theme-toggle');
    const sun = toggle?.querySelector('.theme-toggle__icon--sun');
    const moon = toggle?.querySelector('.theme-toggle__icon--moon');

    function updateIcons(isDark) {
      if (sun) sun.style.display = isDark ? 'none' : 'block';
      if (moon) moon.style.display = isDark ? 'block' : 'none';
    }

    if (toggle) {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      updateIcons(currentTheme === 'dark');

      toggle.addEventListener('click', () => {
        const html = document.documentElement;
        const isDark = html.getAttribute('data-theme') === 'dark';
        if (isDark) {
          html.removeAttribute('data-theme');
          localStorage.setItem('theme', 'light');
          updateIcons(false);
        } else {
          html.setAttribute('data-theme', 'dark');
          localStorage.setItem('theme', 'dark');
          updateIcons(true);
        }
      });
    }
  </script>
  <script data-nav-script>
    const navToggle = document.getElementById('nav-toggle');
    const navMenu = document.getElementById('masthead-menu');
    if (navToggle && navMenu) {
      const setOpen = (open) => {
        navMenu.classList.toggle('is-open', open);
        navToggle.classList.toggle('is-active', open);
        navToggle.setAttribute('aria-expanded', String(open));
        navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      navToggle.addEventListener('click', () => setOpen(!navMenu.classList.contains('is-open')));
      navMenu.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => setOpen(false))
      );
      document.addEventListener('click', (e) => {
        if (!navToggle.contains(e.target) && !navMenu.contains(e.target)) setOpen(false);
      });
    }
  </script>
</header>

<style>
  .masthead {
    border-bottom: 1px solid var(--rule);
    background: var(--paper-raised);
  }

  .masthead__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.8rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
  }

  .wordmark__logo {
    width: 28px;
    height: 28px;
    display: block;
  }

  .wordmark__text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--crimson);
    white-space: nowrap;
  }

  /* Nav links + theme toggle live together as one cluster on the right. */
  .masthead__cluster {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .masthead__nav {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  /* Target the list classes directly (not the `ul` element) so these rules
     don't out-specify the mobile overrides that hide/show each list. */
  .masthead__nav-bar,
  .masthead__nav-menu {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .masthead__nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 36px;
    padding: 0.4rem 0.7rem;
    border-radius: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .masthead__nav a:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .masthead__nav a[aria-current='page'] {
    color: var(--crimson);
    background: color-mix(in srgb, var(--crimson) 10%, transparent);
    font-weight: 600;
  }

  .masthead__nav .nav-icon {
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
  }

  .theme-toggle {
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 0.4rem;
    padding: 0;
    cursor: pointer;
    color: var(--ink-soft);
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--crimson);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .theme-toggle__icon {
    width: 20px;
    height: 20px;
  }

  .theme-toggle__icon--moon {
    display: none;
  }

  [data-theme='dark'] .theme-toggle__icon--sun {
    display: none;
  }

  [data-theme='dark'] .theme-toggle__icon--moon {
    display: block;
  }

  /* Hamburger — hidden on desktop, takes over the nav on phones. */
  .hamburger {
    display: none;
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 0.4rem;
    padding: 0;
    cursor: pointer;
    color: var(--ink-soft);
    transition: all 0.15s ease;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
  }

  .hamburger:hover {
    color: var(--ink);
    border-color: var(--crimson);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .hamburger__icon {
    width: 20px;
    height: 20px;
  }

  .hamburger__icon--close {
    display: none;
  }

  .hamburger.is-active .hamburger__icon {
    display: none;
  }

  .hamburger.is-active .hamburger__icon--close {
    display: block;
  }

  @media (max-width: 640px) {
    .masthead__inner {
      flex-wrap: nowrap;
      gap: 0.4rem 1rem;
      padding-block: 0.7rem;
    }

    .wordmark {
      order: 1;
      margin-right: auto;
    }

    .masthead__cluster {
      order: 2;
      gap: 0.3rem;
    }

    /* The hamburger takes over the nav on phones. */
    .hamburger {
      display: inline-flex;
    }

    .masthead__nav {
      position: relative;
    }

    /* Home stays as a normal inline link in the top bar. */
    .masthead__nav-bar {
      gap: 0.15rem;
    }

    .masthead__nav-bar a {
      flex-direction: row;
      gap: 0.45rem;
      min-height: 36px;
      padding: 0.4rem 0.7rem;
    }

    .masthead__nav-bar .nav-icon {
      width: 1.05rem;
      height: 1.05rem;
    }

    .masthead__nav-bar .nav-label {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
    }

    /* The rest of the menu hides behind the hamburger until opened. */
    .masthead__nav-menu {
      display: none;
    }

    .masthead__nav-menu.is-open {
      display: block;
      position: absolute;
      top: calc(100% + 0.6rem);
      right: 0;
      min-width: 13rem;
      background: var(--paper-raised);
      border: 1px solid var(--rule);
      border-radius: 0.5rem;
      box-shadow: 0 12px 32px -12px rgb(22 35 60 / 0.35);
      padding: 0.5rem;
      z-index: 200;
    }

    .masthead__nav-menu.is-open li {
      display: block;
    }

    .masthead__nav-menu.is-open a {
      flex-direction: row;
      justify-content: flex-start;
      gap: 0.55rem;
      min-height: 40px;
      padding: 0.5rem 0.75rem;
      border-radius: 0.4rem;
      font-size: 0.95rem;
    }

    .masthead__nav-menu.is-open .nav-label {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
    }

    .masthead__nav-menu.is-open .nav-icon {
      width: 1.1rem;
      height: 1.1rem;
    }
  }
</style>
