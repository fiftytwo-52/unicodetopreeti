---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Comma-separated keyword list for the meta keywords tag. */
  keywords?: string;
  /** Open Graph type; pages override to "article" where relevant. */
  ogType?: 'website' | 'article';
  /** Path (not full URL) of the social sharing image. */
  ogImage?: string;
  /** Alt text describing the social sharing image. */
  ogImageAlt?: string;
  /** JSON-LD to embed, for tool and FAQ pages. */
  schema?: Record<string, unknown>;
  /** Set to exclude the page from search indexes (e.g. 404). */
  noindex?: boolean;
}

const {
  title,
  description,
  keywords,
  ogType = 'website',
  ogImage = '/og-image.png',
  ogImageAlt = 'Unicode to Preeti converter — free online Nepali text tool',
  schema,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f2ed" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#13171e" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" href="/logo.svg" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4GR8R023TF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-4GR8R023TF');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="unicodeTOpreeti" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;600;700&family=Mukta:wght@400;600&family=IBM+Plex+Mono:wght@400&display=swap"
    />

    {
      schema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      )
    }
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ink);
        color: #fff;
        padding: 0.6rem 1rem;
        z-index: 10;
      }

      .skip:focus {
        left: 0.5rem;
        top: 0.5rem;
      }
    </style>
  </body>
</html>
