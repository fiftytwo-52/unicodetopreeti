---
import ErrorPage from '../components/ErrorPage.astro';

const title = 'Page not found — unicodeTOpreeti';
const description =
  'That page does not exist or has moved. Pick a converter to continue: Unicode to Preeti or Roman to Nepali.';
---

<ErrorPage
  code="404"
  title="That page does not exist"
  lede="The address you typed is not on this site. It may have moved, or the link may be out of date. Pick a converter and carry on."
  watermark="अस्ति"
  {title}
  {description}
/>
