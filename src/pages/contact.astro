---
import BaseLayout from '../layouts/BaseLayout.astro';
import { mailto } from '../lib/site.ts';

const title = 'Contact — unicodeTOpreeti';
const description =
  'Report a mapping error, ask a question, or suggest a font. What to include so a conversion bug can be reproduced.';
---

<BaseLayout title={title} description={description}>
  <div class="shell">
    <div class="hangs intro">
      <h1>Contact</h1>
      <p class="lede">
        Found a word that didn't convert right? Send it here and it gets fixed
        for everyone.
      </p>
    </div>

    <section class="hangs hangs--thin">
      <div class="beta-warning">
        <strong>Note:</strong> This site is still in development. Some conversions
        may not be perfect yet, but every reported error helps improve it.
      </div>

      <h2>Report a conversion error</h2>
      <p>
        If a word doesn't look right after converting, email me at{' '}
        <a href={mailto('Mapping error')}>gun-yes@proton.me</a> with:
      </p>
      <ul class="report-list">
        <li><strong>What you typed</strong> — the original text</li>
        <li><strong>What came out</strong> — the converted result</li>
        <li><strong>What you expected</strong> — the correct output</li>
      </ul>
      <p>
        Paste text directly into the email — don't attach Word files, as they
        can re-encode characters and hide the problem.
      </p>

      <h2>Other questions</h2>
      <p>
        For suggestions, problems, feedback, or advertising, reach out to{' '}
        <a href={mailto('General')}>gun-yes@proton.me</a>.
      </p>

      <h2>Privacy</h2>
      <p>
        Reported text is only used to fix the conversion. It's never shared,
        published, or added to any dataset. All conversions happen in your
        browser — your text is never sent to any server.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .intro {
    padding-top: 1.5rem;
  }

  .beta-warning {
    background: #fff3cd;
    border: 1px solid #ffc107;
    border-radius: 0.35rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
    font-size: var(--step--1);
    color: #856404;
  }

  .report-list {
    margin: 0.75rem 0 1rem 1.25rem;
    color: var(--ink-soft);
  }

  .report-list li {
    margin-bottom: 0.35rem;
  }

  .report-list strong {
    color: var(--ink);
  }
</style>
