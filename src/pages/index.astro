---
import BaseLayout from '../layouts/BaseLayout.astro';
import Converter from '../components/Converter.astro';
import ModeSwitch from '../components/ModeSwitch.astro';

const title = 'Unicode to Preeti Converter — unicodeTOpreeti';
const description =
  'Convert Nepali Unicode text to Preeti font encoding in your browser. Handles conjuncts, reph and the i-matra reordering that trips up simple converters.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Unicode to Preeti Converter',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="shell">
        <ModeSwitch />

    <div class="converter-wrapper">
      <div class="ad ad--left">
        <a href="#" target="_blank" rel="noopener" class="ad__link">
          <img src="" alt="" class="ad__image" />
        </a>
      </div>

      <Converter mode="unicode-to-preeti" sample="नेपाल सरकार, कार्यालयको निर्णय अनुसार वर्ष २०८२" />

      <div class="ad ad--right">
        <a href="#" target="_blank" rel="noopener" class="ad__link">
          <img src="" alt="" class="ad__image" />
        </a>
      </div>
    </div>

    <p class="converter-description">
      Paste Nepali Unicode and get Preeti-encoded text you can drop into a document that still uses the old font.
    </p>
  </div>

  
  <section class="summary-section">
    <h2>About this tool</h2>
    <p>
      Nepali text on the web uses Unicode, which doesn't copy cleanly into
      desktop applications like PageMaker or Word — you'll get garbled
      characters instead. To use Nepali in these apps, the text needs to be
      mapped to ASCII characters that a font like Preeti can render. This tool
      does exactly that. If the output looks like random English letters, you
      don't have the Preeti font installed — download and install it, and the
      text will display correctly.
    </p>
  </section>

  <section class="info-section">
    <div class="info-grid">
      <div class="info-card">
        <h2>Two encodings, one script</h2>
        <p>
          Nepali text on the web uses Unicode — a universal encoding that works
          in every browser and on every device. But older desktop publishing
          tools like PageMaker and Word were built around the Preeti font, which
          maps Devanagari shapes onto ASCII codepoints. The two encodings
          represent the same script, just with different character sets.
        </p>
      </div>
      <div class="info-card">
        <h2>Your text stays on your device</h2>
        <p>
          Conversion happens entirely in your browser. Nothing you type gets
          sent to a server, stored, or logged. The page works offline once
          loaded, and the source code is open for anyone to inspect.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .converter-description {
    text-align: center;
    color: var(--ink-soft);
    font-size: var(--step-0);
    margin: 1.5rem auto 0;
    max-width: 60ch;
    line-height: 1.5;
  }

  .converter-wrapper {
    display: flex;
    justify-content: center;
    position: relative;
    width: 100%;
  }

  .converter-wrapper :global(.converter) {
    flex: 1;
    max-width: 2600px;
  }

  .ad {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0.4;
    transition: opacity 0.2s ease;
    z-index: 10;
  }

  .ad--left { left: 5px; }
  .ad--right { right: 5px; }

  .ad:hover { opacity: 0.7; }

  .ad__link {
    display: block;
    text-decoration: none;
    width: 160px;
    height: 600px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 0.25rem;
  }

  .ad__image {
    display: none;
  }

  @media (max-width: 1000px) {
    .ad { display: none; }
  }

  .summary-section {
    width: min(100% - 2.5rem, 800px);
    margin: 3rem auto 0;
    padding: 1.75rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 0.35rem;
  }

  .summary-section h2 {
    font-size: var(--step-1);
    margin-top: 0;
    margin-bottom: 0.75rem;
    color: var(--ink);
  }

  .summary-section p {
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0;
    max-width: none;
  }

  .info-section {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .info-card {
    padding: 1.5rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 0.35rem;
  }

  .info-card h2 {
    font-size: var(--step-1);
    margin-top: 0;
    margin-bottom: 0.75rem;
    color: var(--ink);
  }

  .info-card p {
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 720px) {
    .info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
