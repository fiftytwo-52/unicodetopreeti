---
import BaseLayout from '../layouts/BaseLayout.astro';
import Converter from '../components/Converter.astro';
import ModeSwitch from '../components/ModeSwitch.astro';

const title = 'Mangal to Preeti Converter — Most Accurate, Self-Formatting';
const description =
  'Mangal to Preeti converter — Mangal is a Unicode font, so paste your Mangal-typed Nepali text and get Preeti output instantly. Most accurate, self-formatting, free, no signup.';

// Mangal is a Unicode font, so the same Unicode → Preeti path applies.
// Keywords target the exact queries people type, not a separate encoding.
const keywords = [
  'mangal to preeti',
  'mangal to preeti converter',
  'mangal font to preeti',
  'convert mangal to preeti',
  'unicode mangal to preeti',
  'mangal to preeti font converter',
  'mangal to preeti online',
  'most accurate mangal to preeti converter',
].join(', ');

const faqs = [
  {
    q: 'How to convert Mangal to Preeti?',
    a: 'Paste your Mangal-typed Nepali text into the left pane. Mangal is a Unicode font, so your text is already Unicode Devanagari underneath — the converter maps it to Preeti encoding instantly in the right pane. Copy the result, paste it into your document, and set the font to Preeti.',
  },
  {
    q: 'Is Mangal to Preeti different from Unicode to Preeti?',
    a: 'No. Mangal, Kalimati, Nirmala UI and Kokila are all Unicode fonts: they store the same Unicode characters, only the on-screen shapes differ. So converting Mangal to Preeti works exactly like any Unicode to Preeti conversion — there is no special Mangal step.',
  },
  {
    q: 'What does most accurate, self-formatting mean here?',
    a: 'The converter works syllable by syllable, not character by character: it auto-reorders i-matra, reph and conjuncts into Preeti visual order, and the Cleanup tools tidy tabs, spacing before । ? !, math spacing, and repeated spaces. The conversion is verified by 401 automated conversion checks. "Most accurate" means built for the cases where simple converters fail — not a rating or comparative study.',
  },
  {
    q: 'Why does the Preeti output look like English letters?',
    a: 'That is what Preeti text is: the font maps Nepali shapes onto English codepoints. Paste the output into your document, select it, and set the font to Preeti — the Nepali shapes appear then. If they do not, Preeti is not installed on that computer.',
  },
  {
    q: 'Is my text sent to a server?',
    a: 'No. Conversion happens entirely in your browser and nothing you type is uploaded, stored or logged. The page even keeps working offline once it has loaded.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://unicodetopreeti.xyz/mangal-to-preeti#app',
      name: 'Mangal to Preeti Converter',
      alternateName: ['Mangal Font to Preeti Converter'],
      url: 'https://unicodetopreeti.xyz/mangal-to-preeti',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description,
      inLanguage: ['en', 'ne'],
      featureList: [
        'Convert Mangal-typed Unicode text to Preeti instantly',
        'Most accurate, self-formatting: syllable-level engine',
        'Verified by 401 automated conversion checks',
        'On-device conversion, nothing leaves your device',
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://unicodetopreeti.xyz/mangal-to-preeti#faq',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description} keywords={keywords} schema={schema}>
  <div class="shell">
    <h1 class="page-title">Mangal to Preeti Converter</h1>
    <p class="page-subtitle">
      Mangal is a Unicode font — paste your Mangal-typed Nepali text and get Preeti output instantly. Most accurate, self-formatting, free, unlimited, and private.
    </p>

    <ModeSwitch />

    <div class="converter-wrapper">
      <Converter mode="unicode-to-preeti" sample="नेपाल सरकार, कार्यालयको निर्णय अनुसार वर्ष २०८२" />
    </div>
  </div>

  <div class="shell">
    <section class="hangs hangs--thin">
      <h2>About the Mangal to Preeti Converter</h2>
      <p>
        This page converts Mangal-typed Nepali text to Preeti. Mangal is a
        Unicode font, so text typed in Mangal is already Unicode Devanagari
        underneath — the font only changes how it looks on screen. That means
        there is no special Mangal step: paste your Mangal-typed text into the
        left pane and the converter maps it to Preeti encoding in the right
        pane, exactly like the main
        <a href="/">Unicode to Preeti converter</a>.
      </p>
      <p>
        Self-formatting means you never have to fix the output by hand: the
        syllable-level engine automatically reorders i-matra, reph and
        conjuncts into Preeti visual order as you type, and the Cleanup tools
        below the panes tidy tabs, spacing before । ? !, math spacing, and
        repeated spaces. The conversion is verified by 401 automated conversion
        checks covering matras, half forms, conjuncts, reph clusters, digits
        and round trips in both directions.
      </p>
      <p>
        Copy the result, paste it into your document, and set the font to
        Preeti. If the pasted text still looks like English letters, Preeti is
        not installed on that computer — see the
        <a href="/preeti-font-download">Preeti font download</a> page. For
        text typed in another Unicode font, use the
        <a href="/kalimati-to-preeti">Kalimati to Preeti converter</a>. For
        Nepali typed in English letters, use the
        <a href="/roman-to-preeti">Roman to Preeti converter</a>. Kantipur is a
        different legacy encoding, so use the
        <a href="/unicode-to-kantipur">Unicode to Kantipur converter</a> for
        Kantipur-encoded text.
      </p>
    </section>

    <section class="hangs hangs--thin">
      <h2>Frequently asked questions</h2>
      <dl class="faq">
        {
          faqs.map((faq) => (
            <div class="faq__item">
              <dt>{faq.q}</dt>
              <dd>{faq.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</BaseLayout>

<style>
  .page-title {
    font-family: var(--font-display);
    font-size: var(--step-4);
    text-align: center;
    margin: 1.5rem 0 0.5rem;
    color: var(--ink);
  }

  .page-subtitle {
    text-align: center;
    color: var(--ink-soft);
    margin: 0 auto 1rem;
    max-width: 60ch;
  }

  .converter-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .converter-wrapper :global(.converter) {
    flex: 1;
    max-width: 2600px;
  }

  .faq {
    margin: 1.25rem 0 0;
    max-width: var(--measure);
  }

  .faq__item + .faq__item {
    margin-top: 1.5rem;
  }

  .faq dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-0);
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--rule);
  }

  .faq dd {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
  }
</style>
