---
import BaseLayout from '../layouts/BaseLayout.astro';
import Converter from '../components/Converter.astro';

const title = 'Preeti to Unicode Converter — Nepali Text Tools';
const description =
  'Convert Preeti font text to Nepali Unicode Devanagari in your browser. Turn old documents into text that works on the web, in email and on phones.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Preeti to Unicode Converter',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="shell">
    <div class="hangs intro">
      <h1>Preeti to Unicode</h1>
      <p class="lede">
        Bring text out of old Preeti documents into Unicode Devanagari that
        works everywhere — the web, email, phones and search.
      </p>
    </div>

    <Converter mode="preeti-to-unicode" sample="g]kfnL ejgdf :jfut 5" />

    <div class="hangs hangs--thin">
      <h2>Copying out of an old document</h2>
      <p>
        Select the Preeti text in your document and copy it as plain text. What
        lands in your clipboard will look like Latin gibberish — that is the
        underlying encoding, and it is exactly what this converter reads.
      </p>
      <p>
        If you paste and see Devanagari already, the source was Unicode to begin
        with and needs no conversion.
      </p>

      <h2>Why convert at all</h2>
      <p>
        Preeti text is only readable where the font is installed. It cannot be
        searched, it breaks in email and on phones, and screen readers cannot
        speak it. Unicode is the same script stored properly, so it travels
        anywhere and stays searchable.
      </p>

      <h2>When the output looks wrong</h2>
      <p>
        A few Preeti variants remap keys, and hand-typed documents sometimes use
        one glyph where another was intended. If a word comes out garbled,
        checking that stretch against the original usually shows a substituted
        character. Editing either pane re-converts immediately, so you can fix
        it in place.
      </p>
      <p>
        Text that was typed in a different legacy font — Kantipur, Sagarmatha,
        PCS Nepali — uses a different mapping and will not convert correctly
        here.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .intro {
    padding-top: 1.5rem;
  }
</style>
