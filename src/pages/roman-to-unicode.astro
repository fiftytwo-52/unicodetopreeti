---
import BaseLayout from '../layouts/BaseLayout.astro';
import Converter from '../components/Converter.astro';

const title = 'Roman Nepali to Unicode — Type Nepali in English Letters';
const description =
  'Type Nepali using English letters and get Unicode Devanagari as you type. No Nepali keyboard needed. Works on phones and in any browser.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Roman Nepali to Unicode Converter',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="shell">
    <div class="hangs intro">
      <h1>Roman Nepali to Unicode</h1>
      <p class="lede">
        Type the way you already text — <span class="sample">mero ghar</span>
        becomes <span class="devanagari">मेरो घर</span>. Conversion happens as
        you type, no keyboard layout to install.
      </p>
    </div>

    <div class="mode-switch">
      <a href="/unicode-to-preeti" class="mode-switch__btn">Unicode to Preeti</a>
      <a href="/roman-to-unicode" class="mode-switch__btn is-active">Roman to Nepali</a>
    </div>

    <Converter mode="roman-to-unicode" sample="ma timilai maya garchhu" />

  </div>
</BaseLayout>

<style>
  .intro {
    padding-top: 1.5rem;
  }

  .sample {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    padding: 0.05em 0.3em;
  }

  .mode-switch {
    display: flex;
    gap: 0.5rem;
    margin: 1.5rem 0 1rem;
  }

  .mode-switch__btn {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.55rem 1.2rem;
    border: 2px solid var(--rule);
    border-radius: 0.35rem;
    text-decoration: none;
    color: var(--ink-soft);
    background: var(--paper-raised);
    transition: all 0.15s ease;
  }

  .mode-switch__btn:hover {
    color: var(--ink);
    border-color: var(--crimson);
  }

  .mode-switch__btn.is-active {
    color: #fff;
    background: var(--crimson);
    border-color: var(--crimson);
  }

  @media (max-width: 560px) {
    .mode-switch__btn {
      flex: 1;
      text-align: center;
    }
  }

</style>
