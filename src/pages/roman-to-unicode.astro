---
import BaseLayout from '../layouts/BaseLayout.astro';
import Converter from '../components/Converter.astro';
import ModeSwitch from '../components/ModeSwitch.astro';

const title = 'Roman Nepali to Unicode — unicodeTOpreeti';
const description =
  'Type Nepali using English letters and get Unicode Devanagari as you type. No Nepali keyboard needed. Works on phones and in any browser.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Roman Nepali to Unicode Converter',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};

---

<BaseLayout title={title} description={description} schema={schema}>
  <div class="shell">
    <ModeSwitch />

      <div class="converter-wrapper">
    <div class="ad ad--left">
      <a href="#" target="_blank" rel="noopener" class="ad__link">
        <img src="" alt="" class="ad__image" />
      </a>
    </div>

    <Converter mode="roman-to-unicode" sample="ma timilai maya garchhu" />

    <div class="ad ad--right">
      <a href="#" target="_blank" rel="noopener" class="ad__link">
        <img src="" alt="" class="ad__image" />
      </a>
    </div>
  </div>

  <p class="converter-description">
    Type the way you already text — mero ghar becomes मेरो घर. Conversion happens as you type, no keyboard layout to install.
  </p>
</div>

  <section class="summary-section">
    <h2>About this tool</h2>
    <p>
      Nepali text on the web uses Unicode, which doesn't copy cleanly into
      desktop applications like PageMaker or Word — you'll get garbled
      characters instead. To use Nepali in these apps, the text needs to be
      mapped to ASCII characters that a font like Preeti can render. This tool
      does exactly that. If the output looks like random English letters, you
      don't have the Preeti font installed — download and install it, and the
      text will display correctly.
    </p>
  </section>

  <section class="info-section">
    <div class="info-grid">
      <div class="info-card">
        <h2>Two encodings, one script</h2>
        <p>
          Nepali text on the web uses Unicode — a universal encoding that works
          in every browser and on every device. But older desktop publishing
          tools like PageMaker and Word were built around the Preeti font, which
          maps Devanagari shapes onto ASCII codepoints. The two encodings
          represent the same script, just with different character sets.
        </p>
      </div>
      <div class="info-card">
        <h2>Your text stays on your device</h2>
        <p>
          Conversion happens entirely in your browser. Nothing you type gets
          sent to a server, stored, or logged. The page works offline once
          loaded, and the source code is open for anyone to inspect.
        </p>
      </div>
    </div>
    </section>
  <!-- Popup Ad -->
  <div class="popup-ad" id="popupAd" role="dialog" aria-modal="true" aria-label="Advertisement">
    <div class="popup-ad__box">
      <a href="#" target="_blank" rel="noopener" class="popup-ad__link">
        <img src="" alt="" class="popup-ad__image" />
      </a>
      <button type="button" class="popup-ad__close" id="popupAdClose" aria-label="Close advertisement">
        <svg class="popup-ad__close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const popup = document.getElementById('popupAd');
    const closeBtn = document.getElementById('popupAdClose');
    const close = () => { if (popup) popup.classList.remove('is-visible'); };
    setTimeout(() => { if (popup) popup.classList.add('is-visible'); }, 1500);
    if (closeBtn) closeBtn.addEventListener('click', close);
    if (popup) {
      popup.addEventListener('click', (e) => { if (e.target === popup) close(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    }
  });
</script>

<style>
  .converter-description {
    text-align: center;
    color: var(--ink-soft);
    font-size: var(--step-0);
    margin: 1.5rem auto 0;
    max-width: 60ch;
    line-height: 1.5;
  }

  .converter-wrapper {
    display: flex;
    justify-content: center;
    position: relative;
    width: 100%;
  }

  .converter-wrapper :global(.converter) {
    flex: 1;
    max-width: 2600px;
  }

  .ad {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0.4;
    transition: opacity 0.2s ease;
    z-index: 10;
  }

  .ad--left { left: 5px; }
  .ad--right { right: 5px; }

  .ad:hover { opacity: 0.7; }

  .ad__link {
    display: block;
    text-decoration: none;
    width: 160px;
    height: 600px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 0.25rem;
  }

  .ad__image {
    display: none;
  }

  .popup-ad {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .popup-ad.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .popup-ad__box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    width: min(400px, calc(100vw - 2rem));
  }

  .popup-ad__link {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    background: var(--paper-raised);
    border-radius: 0.5rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
  }

  .popup-ad__image {
    display: none;
  }

  .popup-ad__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border-radius: 50%;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    color: var(--ink);
    cursor: pointer;
    line-height: 1;
    transition: all 0.15s ease;
  }

  .popup-ad__close:hover {
    color: #fff;
    background: var(--crimson);
    border-color: var(--crimson);
  }

  .popup-ad__close-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (max-width: 1000px) {
    .ad { display: none; }
  }

  .info-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .summary-section {
    width: min(100% - 2.5rem, 800px);
    margin: 3rem auto 0;
    padding: 1.75rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 0.35rem;
  }

  .summary-section h2 {
    font-size: var(--step-1);
    margin-top: 0;
    margin-bottom: 0.75rem;
    color: var(--ink);
  }

  .summary-section p {
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0;
    max-width: none;
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .info-card {
    padding: 1.5rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 0.35rem;
  }

  .info-card h2 {
    font-size: var(--step-1);
    margin-top: 0;
    margin-bottom: 0.75rem;
    color: var(--ink);
  }

  .info-card p {
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 720px) {
    .info-grid {
      grid-template-columns: 1fr;
    }
  }

</style>
